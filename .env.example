# Local development only. HTTP/WebSocket on localhost; configure HTTPS/WSS for deployment.
PORT=2567
VITE_API_ORIGIN=http://localhost:2567

# Exact comma-separated frontend origins for the room-creation API; no trailing slash.
# Example: ALLOWED_ORIGINS=https://your-preview.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only behind a trusted ingress proxy (Railway staging).
TRUST_PROXY=0
